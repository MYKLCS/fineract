# Fineract Application Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fineract

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
RUST_LOG=fineract_api=debug,tower_http=debug

# Environment
ENVIRONMENT=development

# Optional: Database Pool Configuration
DB_MAX_CONNECTIONS=50
DB_MIN_CONNECTIONS=5

# Optional: Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Optional: File Upload
MAX_UPLOAD_SIZE_MB=10

# Optional: Redis (for caching/sessions)
# REDIS_URL=redis://localhost:6379

# Optional: Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: External Services
# PAYMENT_GATEWAY_URL=https://api.payment-provider.com
# PAYMENT_GATEWAY_KEY=your-payment-gateway-key